{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(execute_command|write_file|write_to_file|apply_diff|search_and_replace|insert_content|edit_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "INBIN_GATE_WORKSPACE=\"$PWD\" INBIN_GATE_REPO=\"$PWD/sample-project\" node \"$PWD/gate/hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INBIN_GATE_WORKSPACE=\"$PWD\" INBIN_GATE_REPO=\"$PWD/sample-project\" node \"$PWD/gate/hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}